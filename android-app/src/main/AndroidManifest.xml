<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ieslasalle.asistencia">

    <!-- Permisos necesarios -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Permisos opcionales para la app -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <application
        android:allowBackup="true"
        android:dataSyncWhitelist="com.ieslasalle.asistencia"
        android:extractRetainedUserData="false"
        android:grantIsolatedPermissions="true"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Asistencia IES La Salle"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Assistencia.App">

        <!-- Configuración de seguridad de red para Supabase -->
        <meta-data
            android:name="com.supabase.supporter"
            android:value="true"/>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Actividades adicionales -->
        <activity
            android:name=".auth.AuthActivity"
            android:exported="false"/>
        <activity
            android:name=".scanner.ScannerActivity"
            android:exported="false"
            android:hardwareAccelerated="true"/>
        <activity
            android:name=".marcar.MarcarActivity"
            android:exported="false"/>
        <activity
            android:name=".admin.DashboardActivity"
            android:exported="false"/>

        <!-- Configuración de cámara para QR -->
        <meta-data
            android:name="android.hardware.camera.autofocus"
            android:value="true"/>
        <meta-data
            android:name="android.hardware.camera.any"
            android:value="true"/>
    </application>
</manifest>